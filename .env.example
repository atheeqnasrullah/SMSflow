# Used by docker-compose.yml. Copy to .env and change every secret for shared environments.
PUBLIC_URL=http://localhost

POSTGRES_PASSWORD=smsflow
APP_DB_PASSWORD=smsflow_app

# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-local-dev-secret-change-me-local-dev-secret
# python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=bG9jYWwtZGV2LWtleS1kby1ub3QtdXNlLWluLXByb2Q=
OTP_HASH_SECRET=change-me-otp-secret

# PayHere (sandbox merchant from https://sandbox.payhere.lk). Empty → dev "simulate payment" button.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Email (leave SMTP_HOST empty to log emails instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=SMSFlow <no-reply@smsflow.lk>

SENTRY_DSN=
FLOWER_USER=admin
FLOWER_PASSWORD=change-me

SEED_ADMIN_EMAIL=admin@smsflow.lk
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
