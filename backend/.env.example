# --- Local development without Docker (SQLite + in-process tasks) ---------------------------
ENV=local
DATABASE_URL=sqlite+aiosqlite:///./smsflow.db
TASK_MODE=inline
REDIS_URL=memory://
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Demo gateway behaviour
DEMO_DLR_MIN_DELAY=2
DEMO_DLR_MAX_DELAY=10

# Secrets – generate real values for any shared environment:
#   python -c "import secrets,base64;print(secrets.token_urlsafe(48));print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=change-me-local-dev-secret-change-me-local-dev-secret
ENCRYPTION_KEY=bG9jYWwtZGV2LWtleS1kby1ub3QtdXNlLWluLXByb2Q=
OTP_HASH_SECRET=change-me-otp-secret

# PayHere sandbox (leave empty to use the dev "simulate payment" button)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Seed admin (python -m app.scripts.seed)
SEED_ADMIN_EMAIL=admin@smsflow.lk
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
